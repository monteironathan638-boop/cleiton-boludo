        Z.Notify("Erro no módulo " .. mod.name, tostring(err):sub(1, 90), Z.Colors.Danger, 6)
    end
else
    Z.Notify("Jogo não suportado", "GameId " .. tostring(id) .. ". Apenas Home e Player disponíveis.", Z.Colors.Warning, 5)
end

